# Telegram Bot
BOT_TOKEN=your_bot_token_from_botfather

# Webhook (Railway public domain, e.g. https://your-app.up.railway.app)
WEBHOOK_URL=https://your-app.up.railway.app
WEBHOOK_SECRET=choose_a_random_secret_string

# Database
# Local dev (SQLite):
DATABASE_URL=sqlite:///./shortener.db
# Railway production (Postgres) — Railway injects this automatically when you add a Postgres plugin:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Short link domain (used to build the shortened URL shown to users)
# Usually the same as WEBHOOK_URL unless you have a custom domain
SHORT_DOMAIN=https://your-app.up.railway.app

# Short code settings
SHORT_CODE_LENGTH=6

# Logging
LOG_LEVEL=INFO

# App environment
ENVIRONMENT=development
